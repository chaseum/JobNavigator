# === Optional: Anthropic API fallback ===
# Only used if no API key is configured in Settings > AI tab.
# Most users should set their LLM key in the dashboard instead.
# ANTHROPIC_API_KEY=

# === Optional: Claude Code (uses Max/Pro subscription instead of API credits) ===
# Generate with: claude setup-token
# CLAUDE_CODE_OAUTH_TOKEN=

# === Optional: Telegram Notifications (get token from @BotFather) ===
# TELEGRAM_BOT_TOKEN=

# === Optional: Gmail Monitoring (one-time OAuth2 setup) ===
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# === Local AI (default provider). Pick the model in Settings > AI. ===
# Docker reaches Ollama on the host through host.docker.internal (see docker-compose.yml).
# OLLAMA_BASE_URL=http://localhost:11434

# === Optional: Overleaf Git sync (Settings > Copilot > Overleaf = git) ===
# Token from Overleaf > Account Settings > Git integration. Read from the environment only;
# never stored in the database, git config, or logs.
# OVERLEAF_GIT_TOKEN=

# === Where accepted résumés are written (default: ./generated) ===
# GENERATED_DIR=

# === Database (defaults work with docker-compose) ===
DATABASE_URL=postgresql://jobnavigator:password@db:5432/jobnavigator

# === Dashboard Password (empty = no auth on first run) ===
# INITIAL_API_KEY=
